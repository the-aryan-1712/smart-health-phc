# Smart Health — Required Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Maps Platform ─────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
# Restrict this key to: Maps JavaScript API
# Set HTTP referrer restriction to your domain in the Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Maps ID — required for vector maps and deck.gl overlay
# Create at: https://console.cloud.google.com/google/maps-apis/maps
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

# ─── Internal Service URLs ────────────────────────────────────────────────────
# FastAPI is internal-only — never expose port 8000 publicly
FASTAPI_INTERNAL_URL=http://localhost:8000

# Public URL (used for CORS and meta tags)
NEXT_PUBLIC_APP_URL=http://localhost:8080

# ─── App Config ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8080
FASTAPI_PORT=8000

# ─── Cloud Run (production only) ──────────────────────────────────────────────
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=asia-south1
